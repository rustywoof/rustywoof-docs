{
	"name": "rustywoof-docs",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=26.13.0"
	},
	"scripts": {
		"predev": "node scripts/ensure-wasm.mjs && fumadocs-mdx",
		"dev": "next dev",
		"prebuild": "node scripts/ensure-wasm.mjs && fumadocs-mdx",
		"build": "next build",
		"start": "next start",
		"fix-code": "biome check --write --unsafe .",
		"check-code": "biome check .",
		"check-types": "tsc --noEmit",
		"run-tests": "vitest run --reporter=verbose",
		"check-code-limits": "node scripts/check-code-limits.mjs",
		"check-duplicates": "jscpd src scripts tests",
		"audit-deps": "pnpm woof audit"
	},
	"dependencies": {
		"@dev.icons/react": "^1.3.0",
		"@ianramy/rustywoof": "^0.3.0",
		"@tailwindcss/postcss": "^4.3.5",
		"cn": "^0.5.2",
		"fumadocs-core": "^16.19.0",
		"fumadocs-mdx": "^15.6.1",
		"fumadocs-ui": "^16.19.0",
		"katex": "^0.19.1",
		"lenis": "^1.3.27",
		"lucide-react": "^1.72.0",
		"next": "16.4.3",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"vite": "^8.3.8",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@types/mdx": "^2.0.14",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"jscpd": "5.4.3",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2",
		"vitest": "5.1.0"
	},
	"knip": {
		"ignore": [
			".source/**",
			"public/sw.js",
			"public/wasm/rustywoof.js",
			"scripts/**",
			"mdx-components.tsx"
		]
	}
}
